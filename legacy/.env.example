# Скопируйте в legacy/.env и задайте свои пароли (только буквы и цифры,
# без @ : / ? # — они ломают строки подключения).
# legacy/.env в git НЕ коммитится (см. .gitignore).
#
# DB_MYSQL_ROOT_PASSWORD должен совпадать с GitHub Secret DB_MYSQL_ROOT_PASSWORD.
DB_MYSQL_ROOT_PASSWORD=ChangeMeRoot123
DB_MYSQL_PASSWORD=ChangeMeUser123
